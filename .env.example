# Sin secretos. La API lee un archivo `.env` desde backend/ (copie este archivo a backend/.env); la raíz no se lee.
# Base SQLite en datos/runtime/ (ignorada por git). La ruta es relativa a backend/, que es donde corre la API.
# scripts/respaldo.py resuelve la base con esta misma variable.
DATABASE_URL=sqlite:///../datos/runtime/cacao.db
# Obligatorio cambiarlo: use un valor largo y aleatorio.
SECRET_KEY=
# true solo en desarrollo y pruebas: siembra usuarios y lotes de demostración al iniciar.
SEED_DEMO_DATA=false
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOSS_ALERT_THRESHOLD_PERCENT=15
DELAY_ALERT_DAYS=7
