DATABASE_URL=sqlite:///./cacao.db
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=60
SEED_DEMO_DATA=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOSS_ALERT_THRESHOLD_PERCENT=15
DELAY_ALERT_DAYS=7
# Opcional; si no se define, no se generan alertas por costo.
# COST_ALERT_THRESHOLD_COP_PER_KG=25000
# Opcional; carpeta del build del frontend. Por defecto src/frontend/dist en la raíz del repositorio.
# FRONTEND_DIST=
# "production" hace que la API se niegue a arrancar con un SECRET_KEY de ejemplo o menor a 32 caracteres
# o con SEED_DEMO_DATA activo. En desarrollo no valida nada.
# APP_ENV=production
